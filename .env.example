# Copy this file to .env.local and fill in values.
# .env.local is gitignored. Never commit tokens.
# Do NOT use a VITE_ prefix — those values are bundled into the browser.

# Free quota (no token). Expires on the dates in the Aliyun note.
FC_URL=https://aliyun-ee-quota-wbvmebudhe.cn-hangzhou.fcapp.run

